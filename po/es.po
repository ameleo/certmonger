"\n"

#: src/scep.c:376 src/scep.c:395
#, c-format
msgid "No RA certificate (-r) given, and no default known.\n"
msgstr ""
"No se proporciona certificado RA (-r), y no hay valor predeterminado "
"conocido.\n"

