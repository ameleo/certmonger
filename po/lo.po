#: src/dogtag.c:256 src/dogtag.c:261 src/getcert.c:291
#, c-format
msgid "Out of memory.\n"
msgstr "ໜ່ວຍຄວາມຈຳບໍ່ພຽງພໍ.\n"

#: src/certmaster.c:136
#, c-format
msgid "Unable to determine hostname of CA.\n"
msgstr "ບໍ່ສາມາດລະບຸຊື່ໂຮສ (hostname) ຂອງ CA ໄດ້.\n"

#: src/certmaster.c:153 src/dogtag.c:521 src/ipa.c:796
#, c-format
msgid "Unable to read signing request from file \"%s\".\n"
msgstr "ບໍ່ສາມາດອ່ານຄຳຮ້ອງຂໍລົງລາຍເຊັນຈາກໄຟລ໌ \"%s\" ໄດ້.\n"

#: src/certmaster.c:156 src/dogtag.c:524 src/ipa.c:799
#, c-format
msgid "Unable to read signing request from environment variable \"%s\".\n"
msgstr "ບໍ່ສາມາດອ່ານຄຳຮ້ອງຂໍລົງລາຍເຊັນຈາກຕົວປ່ຽນສະພາບແວດລ້ອມ \"%s\" ໄດ້.\n"

#: src/certmaster.c:184
#, c-format
msgid "Error setting up for XMLRPC.\n"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການຕັ້ງຄ່າ XMLRPC.\n"

#: src/certmaster.c:206 src/getcert.c:526 src/getcert.c:545 src/getcert.c:564
#: src/getcert.c:583 src/getcert.c:601 src/getcert.c:694 src/getcert.c:1409
#: src/getcert.c:1796 src/getcert.c:2354 src/getcert.c:2440 src/getcert.c:3021
#: src/getcert.c:3244 src/getcert.c:3272 src/getcert.c:3499 src/getcert.c:3603
#: src/getcert.c:3638 src/getcert.c:3673 src/getcert.c:3710 src/getcert.c:3973
#: src/getcert.c:4429 src/getcert.c:4547 src/getcert.c:4742
#, c-format
msgid "Error parsing server response.\n"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການວິເຄາະການຕອບກັບຈາກເຊີເວີ.\n"

#: src/certmaster.c:210
#, c-format
msgid "Server error.\n"
msgstr "ເຊີເວີຜິດພາດ.\n"

#: src/dogtag.c:226
#, c-format
msgid "Profile params (-O) must be in the form of param=value.\n"
msgstr "ພາຣາມິເຕີໂປຣໄຟລ໌ (-O) ຕ້ອງຢູ່ໃນຮູບແບບ param=value.\n"

#: src/dogtag.c:249
#, c-format
msgid "Submit params (-o) must be in the form of param=value.\n"
msgstr "ພາຣາມິເຕີການສົ່ງ (-o) ຕ້ອງຢູ່ໃນຮູບແບບ param=value.\n"

#: src/dogtag.c:408 src/dogtag.c:413 src/dogtag.c:442
#, c-format
msgid "No agent credentials specified, and no default known.\n"
msgstr "ບໍ່ໄດ້ລະບຸຂໍ້ມູນຢືນຢັນຕົວຕົນຂອງຕົວແທນ (agent) ແລະ ບໍ່ມີຄ່າເລີ່ມຕົ້ນ.\n"

#: src/dogtag.c:418
#, c-format
msgid "Requested renewal, but no serial number provided.\n"
msgstr "ມີການຮ້ອງຂໍຕໍ່ອາຍຸ ແຕ່ບໍ່ໄດ້ລະບຸໝາຍເລກຊີຣຽວ.\n"

#: src/dogtag.c:422
#, c-format
msgid "No end-entity URL (-E) given, and no default known.\n"
msgstr "ບໍ່ໄດ້ລະບຸ URL ຂອງ end-entity (-E) ແລະ ບໍ່ມີຄ່າເລີ່ມຕົ້ນ.\n"

#: src/dogtag.c:427 src/dogtag.c:437 src/dogtag.c:594
#, c-format
msgid "No agent URL (-A) given, and no default known.\n"
msgstr "ບໍ່ໄດ້ລະບຸ URL ຂອງຕົວແທນ (-A) ແລະ ບໍ່ມີຄ່າເລີ່ມຕົ້ນ.\n"

#: src/dogtag.c:432
#, c-format
msgid "No profile/template (-T) given, and no default known.\n"
msgstr "ບໍ່ໄດ້ລະບຸ ໂປຣໄຟລ໌/ເທັມເພລດ (-T) ແລະ ບໍ່ມີຄ່າເລີ່ມຕົ້ນ.\n"

#: src/dogtag.c:452
#, c-format
msgid "Error shutting down NSS.\n"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການປິດການເຮັດວຽກຂອງ NSS.\n"

#: src/dogtag.c:487 src/dogtag.c:777
#, c-format
msgid "Internal error: unknown state.\n"
msgstr "ຂໍ້ຜິດພາດພາຍໃນ: ບໍ່ຮູ້ຈັກສະຖານະ.\n"

#: src/dogtag.c:600
#, c-format
msgid "No agent credentials (-n) given, but they are needed.\n"
msgstr "ບໍ່ໄດ້ລະບຸຂໍ້ມູນຢືນຢັນຕົວຕົນຂອງຕົວແທນ (-n) ເຊິ່ງຈຳເປັນຕ້ອງໃຊ້.\n"

#: src/dogtag.c:757 src/scep.c:619
#, c-format
msgid "Error %d connecting to %s: %s.\n"
msgstr "ຂໍ້ຜິດພາດ %d ໃນການເຊື່ອມຕໍ່ຫາ %s: %s.\n"

#: src/dogtag.c:762 src/scep.c:624
#, c-format
msgid "Error %d connecting to %s.\n"
msgstr "ຂໍ້ຜິດພາດ %d ໃນການເຊື່ອມຕໍ່ຫາ %s.\n"

#: src/dogtag.c:770 src/scep.c:648
#, c-format
msgid "Internal error: no response to \"%s?%s\".\n"
msgstr "ຂໍ້ຜິດພາດພາຍໃນ: ບໍ່ມີການຕອບກັບຈາກ \"%s?%s\".\n"

#: src/getcert.c:61 src/main.c:84 src/main.c:86
msgid "COMMAND"
msgstr "ຄຳສັ່ງ"

#: src/getcert.c:62
msgid "DIRECTORY"
msgstr "ໄດເຣັກທໍຣີ"

#: src/getcert.c:63 src/getcert.c:70
msgid "LIST"
msgstr "ລາຍການ"

#: src/getcert.c:64 src/getcert.c:68
msgid "ADDRESS"
msgstr "ທີ່ຢູ່"

#: src/getcert.c:65 src/main.c:87
msgid "FILENAME"
msgstr "ຊື່ໄຟລ໌"

#: src/getcert.c:66
msgid "HOSTNAME"
msgstr "ຊື່ໂຮສ"

#: src/getcert.c:67
msgid "ID"
msgstr "ໄອດີ"

#: src/getcert.c:69
msgid "BITS"
msgstr "ບິດ"

#: src/getcert.c:71
msgid "MODE"
msgstr "ໂໝດ"

#: src/getcert.c:72
msgid "NAME"
msgstr "ຊື່"

#: src/getcert.c:73
msgid "PRINCIPAL"
msgstr "ພຣິນຊິໂພ (PRINCIPAL)"

#: src/getcert.c:74
msgid "SUBJECT"
msgstr "ຫົວຂໍ້ (SUBJECT)"

#: src/getcert.c:75
msgid "URL"
msgstr "ຢູອາແອວ (URL)"

#: src/getcert.c:76
msgid "USERNAME[:GROUPNAME]"
msgstr "ຊື່ຜູ້ໃຊ້[:ຊື່ກຸ່ມ]"

#: src/getcert.c:115
#, c-format
msgid "Path \"%s\" is not absolute, attempting to use \"%s\" instead.\n"
msgstr "ເສັ້ນທາງ \"%s\" ບໍ່ແມ່ນເສັ້ນທາງເຕັມ, ຈະພະຍາຍາມໃຊ້ \"%s\" ແທນ.\n"

#: src/getcert.c:120
#, c-format
msgid ""
"Path \"%s\" is not absolute, and there was an error determining the name of "
"the current directory.\n"
msgstr ""
"ເສັ້ນທາງ \"%s\" ບໍ່ແມ່ນເສັ້ນທາງເຕັມ ແລະ ເກີດຂໍ້ຜິດພາດໃນການລະບຸຊື່ໄດເຣັກທໍຣີປັດຈຸບັນ.\n"

#: src/getcert.c:142
#, c-format
msgid "Path \"%s\": insufficient permissions.\n"
msgstr "ເສັ້ນທາງ \"%s\": ສິດການເຂົ້າເຖິງບໍ່ພຽງພໍ.\n"

#: src/getcert.c:148
#, c-format
msgid "Path \"%s\" is not a directory.\n"
msgstr "ເສັ້ນທາງ \"%s\" ບໍ່ແມ່ນໄດເຣັກທໍຣີ.\n"

#: src/getcert.c:154
#, c-format
msgid "Path \"%s\": %s.\n"
msgstr "ເສັ້ນທາງ \"%s\": %s.\n"

#: src/getcert.c:194
#, c-format
msgid "Path \"%s\" is not a regular file.\n"
msgstr "ເສັ້ນທາງ \"%s\" ບໍ່ແມ່ນໄຟລ໌ປົກກະຕິ.\n"

#: src/getcert.c:340
#, c-format
msgid "No system bus running.\n"
msgstr "ບໍ່ມີ system bus ເຮັດວຽກຢູ່.\n"

#: src/getcert.c:341
#, c-format
msgid "Running as UID 0.\n"
msgstr "ກຳລັງເຮັດວຽກດ້ວຍ UID 0.\n"

#: src/getcert.c:342
#, c-format
msgid "Launching temporary dedicated service daemon.\n"
msgstr "ກຳລັງເລີ່ມຕົ້ນເດມອນບໍລິການແບບສະເພາະຊົ່ວຄາວ.\n"

#: src/getcert.c:371
#, c-format
msgid "Error connecting to D-Bus.\n"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການເຊື່ອມຕໍ່ຫາ D-Bus.\n"

#: src/getcert.c:372 src/tdbusm.c:2166
#, c-format
msgid "Please verify that the message bus (D-Bus) service is running.\n"
msgstr "ກະລຸນາກວດສອບວ່າບໍລິການ message bus (D-Bus) ກຳລັງເຮັດວຽກຢູ່.\n"

#: src/getcert.c:379
#, c-format
msgid "Error creating DBus request message.\n"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການສ້າງຂໍ້ຄວາມຮ້ອງຂໍ DBus.\n"

#: src/getcert.c:393
#, c-format
msgid "missing argument for %s"
msgstr "ຂາດອາກິວເມນສຳລັບ %s"

#: src/getcert.c:398
msgid "missing argument"
msgstr "ຂາດອາກິວເມນ"

#: src/getcert.c:401
#, c-format
msgid "unrecognized option %s"
msgstr "ບໍ່ຮູ້ຈັກຕົວເລືອກ %s"

#: src/getcert.c:406
msgid "unrecognized option"
msgstr "ບໍ່ຮູ້ຈັກຕົວເລືອກ"

#: src/getcert.c:409
msgid "aliases nested too deeply"
msgstr "ຊື່ນາມແຝງ (aliases) ຊ້ອນກັນເລິກເກີນໄປ"

#: src/getcert.c:412
msgid "bad parameter quoting"
msgstr "ການໃສ່ເຄື່ອງໝາຍຄຳເວົ້າໃນພາຣາມິເຕີບໍ່ຖືກຕ້ອງ"

#: src/getcert.c:418
msgid "invalid numeric value"
msgstr "ຄ່າຕົວເລກບໍ່ຖືກຕ້ອງ"

#: src/getcert.c:421
msgid "number too large or too small"
msgstr "ຕົວເລກໃຫຍ່ ຫຼື ນ້ອຍເກີນໄປ"

#: src/getcert.c:424
msgid "bad operation"
msgstr "ການເຮັດວຽກບໍ່ຖືກຕ້ອງ"

#: src/getcert.c:427
msgid "internal error"
msgstr "ຂໍ້ຜິດພາດພາຍໃນ"

#: src/getcert.c:430
msgid "out of memory"
msgstr "ໜ່ວຍຄວາມຈຳເຕັມ"

#: src/getcert.c:434
msgid "error in popt configuration file"
msgstr "ເກີດຂໍ້ຜິດພາດໃນໄຟລ໌ຕັ້ງຄ່າ popt"

#: src/getcert.c:477
#, c-format
msgid "Error %s: %s\n"
msgstr "ຂໍ້ຜິດພາດ %s: %s\n"

#: src/getcert.c:481
#, c-format
msgid "Error %s\n"
msgstr "ຂໍ້ຜິດພາດ %s\n"

#: src/getcert.c:487
#, c-format
msgid "Error: %s\n"
msgstr "ຂໍ້ຜິດພາດ: %s\n"

#: src/getcert.c:489
#, c-format
msgid "Received error response from local %s service.\n"
msgstr "ໄດ້ຮັບການຕອບກັບທີ່ຜິດພາດຈາກບໍລິການ %s ພາຍໃນເຄື່ອງ.\n"

#: src/getcert.c:495
#, c-format
msgid "No response received from %s service.\n"
msgstr "ບໍ່ໄດ້ຮັບການຕອບກັບຈາກບໍລິການ %s.\n"

#: src/getcert.c:699 src/getcert.c:3978
#, c-format
msgid "State %s, stuck: %s.\n"
msgstr "ສະຖານະ %s, ຄ້າງຢູ່ທີ່: %s.\n"

#: src/getcert.c:768 src/getcert.c:1846 src/getcert.c:2500 src/getcert.c:3100
#: src/getcert.c:3354 src/getcert.c:3875
msgid "NSS database for key and cert"
msgstr "ຖານຂໍ້ມູນ NSS ສຳລັບຄີ ແລະ ໃບຢັ້ງຢືນ"

#: src/getcert.c:769 src/getcert.c:1847 src/getcert.c:2501 src/getcert.c:3101
#: src/getcert.c:3355 src/getcert.c:3876
msgid "nickname for NSS-based storage (only valid with -d)"
msgstr ""
"ຊື່ອ້າງອີງ (nickname) ສຳລັບບ່ອນເກັບຂໍ້ມູນແບບ NSS (ໃຊ້ໄດ້ກັບ -d ເທົ່ານັ້ນ)"

#: src/getcert.c:770 src/getcert.c:1848 src/getcert.c:2502 src/getcert.c:3102
#: src/getcert.c:3356 src/getcert.c:3877
msgid "optional token name for NSS-based storage (only valid with -d)"
msgstr "ຊື່ໂທເຄັນທາງເລືອກສຳລັບບ່ອນເກັບຂໍ້ມູນແບບ NSS (ໃຊ້ໄດ້ກັບ -d ເທົ່ານັ້ນ)"

#: src/getcert.c:771
msgid "PEM file for private key"
msgstr "ໄຟລ໌ PEM ສຳລັບຄີສ່ວນຕົວ (private key)"

#: src/getcert.c:772
msgid "PEM file for certificate (only valid with -k)"
msgstr "ໄຟລ໌ PEM ສຳລັບໃບຢັ້ງຢືນ (ໃຊ້ໄດ້ກັບ -k ເທົ່ານັ້ນ)"

#: src/getcert.c:773 src/getcert.c:1851 src/getcert.c:2508
msgid "file which holds the private key encryption PIN"
msgstr "ໄຟລ໌ທີ່ເກັບ PIN ສຳລັບເຂົ້າລະຫັດຄີສ່ວນຕົວ"

#: src/getcert.c:774 src/getcert.c:1852 src/getcert.c:2509
msgid "private key encryption PIN"
msgstr "PIN ສຳລັບເຂົ້າລະຫັດຄີສ່ວນຕົວ"

#: src/getcert.c:775 src/getcert.c:1853 src/getcert.c:2510
msgid "owner information for private key"
msgstr "ຂໍ້ມູນເຈົ້າຂອງສຳລັບຄີສ່ວນຕົວ"

#: src/getcert.c:776 src/getcert.c:1854 src/getcert.c:2511
msgid "file permissions for private key"
msgstr "ສິດການເຂົ້າເຖິງໄຟລ໌ສຳລັບຄີສ່ວນຕົວ"

#: src/getcert.c:777 src/getcert.c:1855 src/getcert.c:2512
msgid "owner information for certificate"
msgstr "ຂໍ້ມູນເຈົ້າຂອງສຳລັບໃບຢັ້ງຢືນ"

#: src/getcert.c:778 src/getcert.c:1856 src/getcert.c:2513
msgid "file permissions for certificate"
msgstr "ສິດການເຂົ້າເຖິງໄຟລ໌ສຳລັບໃບຢັ້ງຢືນ"

#: src/getcert.c:779 src/getcert.c:1857 src/getcert.c:2514
msgid "NSS database in which to store the CA's certificates"
msgstr "ຖານຂໍ້ມູນ NSS ທີ່ຈະໃຊ້ເກັບໃບຢັ້ງຢືນຂອງ CA"

#: src/getcert.c:780 src/getcert.c:1858 src/getcert.c:2515
msgid "file in which to store the CA's certificates"
msgstr "ໄຟລ໌ທີ່ຈະໃຊ້ເກັບໃບຢັ້ງຢືນຂອງ CA"

