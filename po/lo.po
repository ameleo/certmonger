msgstr "* ໂດຍໃຊ້ຕົວລະບຸຄຳຮ້ອງຂໍ:\n"

#: src/getcert.c:4892 src/getcert.c:4914 src/getcert.c:4962 src/getcert.c:5019
#: src/getcert.c:5040 src/getcert.c:5060
msgid "  -i NAME\tnickname for tracking request\n"
msgstr "  -i NAME\tຊື່ອ້າງອີງສຳລັບຄຳຮ້ອງຂໍຕິດຕາມ\n"

#: src/getcert.c:4910
#, c-format
msgid "Usage: %s resubmit [options]\n"
msgstr "ວິທີໃຊ້: %s resubmit [ຕົວເລືອກ]\n"

#: src/getcert.c:4920 src/getcert.c:4968 src/getcert.c:5046
msgid "  -f FILE\tPEM file for certificate\n"
msgstr "  -f FILE\tໄຟລ໌ PEM ສຳລັບໃບຢັ້ງຢືນ\n"

#: src/getcert.c:4926 src/getcert.c:4974
msgid "* New parameter values for the signing request:\n"
msgstr "* ຄ່າພາຣາມິເຕີໃໝ່ສຳລັບຄຳຮ້ອງຂໍລົງລາຍເຊັນ:\n"

#: src/getcert.c:4939 src/getcert.c:4987
msgid "  -I NAME\tnew nickname to give to tracking request\n"
msgstr "  -I NAME\tຊື່ອ້າງອີງໃໝ່ທີ່ຈະກຳນົດໃຫ້ຄຳຮ້ອງຂໍຕິດຕາມ\n"

#: src/getcert.c:4941 src/getcert.c:4989
msgid "  -c CA\t\tuse the specified CA rather than the current one\n"
msgstr "  -c CA\t\tໃຊ້ CA ທີ່ລະບຸ ແທນ CA ປັດຈຸບັນ\n"

#: src/getcert.c:4958
#, c-format
msgid "Usage: %s rekey [options]\n"
msgstr "ວິທີໃຊ້: %s rekey [ຕົວເລືອກ]\n"

#: src/getcert.c:4993
msgid "  -G TYPE\ttype of new key to be generated\n"
msgstr "  -G TYPE\tປະເພດຂອງຄີໃໝ່ທີ່ຈະສ້າງ\n"

#: src/getcert.c:4994
msgid "  -g SIZE\tsize of new key to be generated\n"
msgstr "  -g SIZE\tຂະໜາດຂອງຄີໃໝ່ທີ່ຈະສ້າງ\n"

#: src/getcert.c:5008
#, c-format
msgid "Usage: %s list [options]\n"
msgstr "ວິທີໃຊ້: %s list [ຕົວເລືອກ]\n"

#: src/getcert.c:5011 src/getcert.c:5035 src/getcert.c:5078 src/getcert.c:5093
#: src/getcert.c:5109 src/getcert.c:5123 src/getcert.c:5142 src/getcert.c:5156
msgid "* General options:\n"
msgstr "* ຕົວເລືອກທົ່ວໄປ:\n"

#: src/getcert.c:5013
msgid "  -c CA\tlist only requests and certs associated with this CA\n"
msgstr "  -c CA\tສະແດງສະເພາະຄຳຮ້ອງຂໍ ແລະ ໃບຢັ້ງຢືນທີ່ກ່ຽວຂ້ອງກັບ CA ນີ້\n"

#: src/getcert.c:5015
msgid "  -r\tlist only information about outstanding requests\n"
msgstr "  -r\tສະແດງສະເພາະລາຍການຂໍ້ມູນກ່ຽວກັບຄຳຮ້ອງຂໍທີ່ຍັງຄ້າງ\n"

#: src/getcert.c:5016
msgid "  -t\tlist only information about tracked certificates\n"
msgstr "  -t\tສະແດງສະເພາະລາຍການຂໍ້ມູນກ່ຽວກັບໃບຢັ້ງຢືນທີ່ຖືກຕິດຕາມ\n"

#: src/getcert.c:5017
msgid "  -u\tdisplay times in UTC instead of local time\n"
msgstr "  -u\tສະແດງເວລາເປັນ UTC ແທນເວລາທ້ອງຖິ່ນ\n"

#: src/getcert.c:5018
msgid "* If selecting a specific request:\n"
msgstr "* ຖ້າເລືອກຄຳຮ້ອງຂໍສະເພາະ:\n"

#: src/getcert.c:5021
msgid "  -d DIR\tonly list requests and certs which use this NSS database\n"
msgstr "  -d DIR\tສະແດງສະເພາະຄຳຮ້ອງຂໍ ແລະ ໃບຢັ້ງຢືນທີ່ໃຊ້ຖານຂໍ້ມູນ NSS ນີ້\n"

#: src/getcert.c:5022
msgid "  -n NAME\tonly list requests and certs which use this nickname\n"
msgstr "  -n NAME\tສະແດງສະເພາະຄຳຮ້ອງຂໍ ແລະ ໃບຢັ້ງຢືນທີ່ໃຊ້ຊື່ອ້າງອີງນີ້\n"

#: src/getcert.c:5024
msgid "  -f FILE\tonly list requests and certs stored in this PEM file\n"
msgstr "  -f FILE\tສະແດງສະເພາະຄຳຮ້ອງຂໍ ແລະ ໃບຢັ້ງຢືນທີ່ເກັບໃນໄຟລ໌ PEM ນີ້\n"

#: src/getcert.c:5026 src/getcert.c:5067 src/getcert.c:5082 src/getcert.c:5098
#: src/getcert.c:5113 src/getcert.c:5132 src/getcert.c:5146 src/getcert.c:5159
msgid "  -S\tconnect to the certmonger service on the system bus\n"
msgstr "  -S\tເຊື່ອມຕໍ່ຫາບໍລິການ certmonger ຜ່ານ system bus\n"

#: src/getcert.c:5027 src/getcert.c:5068 src/getcert.c:5083 src/getcert.c:5099
#: src/getcert.c:5114 src/getcert.c:5133 src/getcert.c:5147 src/getcert.c:5160
msgid "  -s\tconnect to the certmonger service on the session bus\n"
msgstr "  -s\tເຊື່ອມຕໍ່ຫາບໍລິການ certmonger ຜ່ານ session bus\n"

#: src/getcert.c:5033
#, c-format
msgid "Usage: %s refresh [options]\n"
msgstr "ວິທີໃຊ້: %s refresh [ຕົວເລືອກ]\n"

#: src/getcert.c:5036
msgid "  -a\trefresh information about all outstanding requests\n"
msgstr "  -a\tຣີເຟຣຊຂໍ້ມູນກ່ຽວກັບຄຳຮ້ອງຂໍທີ່ຍັງຄ້າງທັງໝົດ\n"

#: src/getcert.c:5056
#, c-format
msgid "Usage: %s status [options]\n"
msgstr "ວິທີໃຊ້: %s status [ຕົວເລືອກ]\n"

#: src/getcert.c:5059
msgid "* Selecting a specific request:\n"
msgstr "* ການເລືອກຄຳຮ້ອງຂໍສະເພາະ:\n"

#: src/getcert.c:5061
msgid "* When using an NSS database for storage:\n"
msgstr "* ເມື່ອໃຊ້ຖານຂໍ້ມູນ NSS ສຳລັບການເກັບຂໍ້ມູນ:\n"

#: src/getcert.c:5062
msgid "  -d DIR\treturn status for the request in this NSS database\n"
msgstr "  -d DIR\tສົ່ງຄືນສະຖານະສຳລັບຄຳຮ້ອງຂໍໃນຖານຂໍ້ມູນ NSS ນີ້\n"

#: src/getcert.c:5063
msgid "  -n NAME\treturn status for cert which uses this nickname\n"
msgstr "  -n NAME\tສົ່ງຄືນສະຖານະສຳລັບໃບຢັ້ງຢືນທີ່ໃຊ້ຊື່ອ້າງອີງນີ້\n"

#: src/getcert.c:5064
msgid "* When using files for storage:\n"
msgstr "* ເມື່ອໃຊ້ໄຟລ໌ສຳລັບການເກັບຂໍ້ມູນ:\n"

#: src/getcert.c:5065
msgid "  -f FILE\treturn status for cert stored in this PEM file\n"
msgstr "  -f FILE\tສົ່ງຄືນສະຖານະສຳລັບໃບຢັ້ງຢືນທີ່ເກັບໃນໄຟລ໌ PEM ນີ້\n"

#: src/getcert.c:5074
#, c-format
msgid "Usage: %s list-cas [options]\n"
msgstr "ວິທີໃຊ້: %s list-cas [ຕົວເລືອກ]\n"

#: src/getcert.c:5079
msgid "  -c CA\tlist only information about the CA with this name\n"
msgstr "  -c CA\tສະແດງສະເພາະຂໍ້ມູນກ່ຽວກັບ CA ທີ່ມີຊື່ນີ້\n"

#: src/getcert.c:5089
#, c-format
msgid "Usage: %s refresh-ca [options]\n"
msgstr "ວິທີໃຊ້: %s refresh-ca [ຕົວເລືອກ]\n"

#: src/getcert.c:5094
msgid "  -c CA\trefresh information about the CA with this name\n"
msgstr "  -c CA\tຣີເຟຣຊຂໍ້ມູນກ່ຽວກັບ CA ທີ່ມີຊື່ນີ້\n"

#: src/getcert.c:5095
msgid "  -a\trefresh information about all known CAs\n"
msgstr "  -a\tຣີເຟຣຊຂໍ້ມູນກ່ຽວກັບ CA ທັງໝົດທີ່ຮູ້ຈັກ\n"

#: src/getcert.c:5106
#, c-format
msgid "Usage: %s add-ca [options]\n"
msgstr "ວິທີໃຊ້: %s add-ca [ຕົວເລືອກ]\n"

#: src/getcert.c:5110 src/getcert.c:5124
msgid "  -c CA\t\tnickname to give to the new CA configuration\n"
msgstr "  -c CA\t\tຊື່ອ້າງອີງທີ່ຈະກຳນົດໃຫ້ກັບການຕັ້ງຄ່າ CA ໃໝ່\n"

#: src/getcert.c:5111
msgid "  -e CMD\thelper command to run to communicate with CA\n"
msgstr "  -e CMD\tຄຳສັ່ງຕົວຊ່ວຍທີ່ຈະໃຊ້ສື່ສານກັບ CA\n"

#: src/getcert.c:5120
#, c-format
msgid "Usage: %s add-scep-ca [options]\n"
msgstr "ວິທີໃຊ້: %s add-scep-ca [ຕົວເລືອກ]\n"

#: src/getcert.c:5125
msgid "  -u URL\tlocation of SCEP server\n"
msgstr "  -u URL\tທີ່ຕັ້ງຂອງເຊີເວີ SCEP\n"

#: src/getcert.c:5126
msgid "  -i ID\t\tCA identifier\n"
msgstr "  -i ID\t\tຕົວລະບຸ CA\n"

#: src/getcert.c:5127
msgid "  -R FILE\tfile containing CA's certificate\n"
msgstr "  -R FILE\tໄຟລ໌ທີ່ບັນຈຸໃບຢັ້ງຢືນຂອງ CA\n"

#: src/getcert.c:5128
msgid "  -r FILE\tfile containing RA's certificate\n"
msgstr "  -r FILE\tໄຟລ໌ທີ່ບັນຈຸໃບຢັ້ງຢືນຂອງ RA\n"

#: src/getcert.c:5129
msgid "  -I FILE\tfile containing certificates in RA's certifying chain\n"
msgstr "  -I FILE\tໄຟລ໌ທີ່ບັນຈຸໃບຢັ້ງຢືນໃນລະບົບໂສ້ການຢັ້ງຢືນຂອງ RA\n"

#: src/getcert.c:5130
msgid "  -n\tprefer not to use the SCEP Renewal feature\n"
msgstr "  -n\tບໍ່ຕ້ອງການໃຊ້ຟີເຈີການຕໍ່ອາຍຸຂອງ SCEP\n"

#: src/getcert.c:5139
#, c-format
msgid "Usage: %s modify-ca [options]\n"
msgstr "ວິທີໃຊ້: %s modify-ca [ຕົວເລືອກ]\n"

#: src/getcert.c:5143
msgid "  -c CA\t\tnickname of the CA configuration\n"
msgstr "  -c CA\t\tຊື່ອ້າງອີງຂອງການຕັ້ງຄ່າ CA\n"

#: src/getcert.c:5144
msgid "  -e CMD\tupdated helper command to run to communicate with CA\n"
msgstr "  -e CMD\tຄຳສັ່ງຕົວຊ່ວຍທີ່ອັບເດດແລ້ວເພື່ອໃຊ້ສື່ສານກັບ CA\n"

#: src/getcert.c:5153
#, c-format
msgid "Usage: %s remove-ca [options]\n"
msgstr "ວິທີໃຊ້: %s remove-ca [ຕົວເລືອກ]\n"

#: src/getcert.c:5157
msgid "  -c CA\tnickname of CA configuration to remove\n"
msgstr "  -c CA\tຊື່ອ້າງອີງຂອງການຕັ້ງຄ່າ CA ທີ່ຈະລຶບອອກ\n"

#: src/getcert.c:5172
#, c-format
msgid "Usage: %s command [options]\n"
msgstr "ວິທີໃຊ້: %s command [ຕົວເລືອກ]\n"

#: src/getcert.c:5174
msgid "request a new certificate from a CA\n"
msgstr "ຮ້ອງຂໍໃບຢັ້ງຢືນໃໝ່ຈາກ CA\n"

#: src/getcert.c:5176
msgid "begin monitoring an already-issued certificate\n"
msgstr "ເລີ່ມຕິດຕາມໃບຢັ້ງຢືນທີ່ໄດ້ອອກໃຫ້ແລ້ວ\n"

#: src/getcert.c:5178
msgid "stop monitoring a certificate\n"
msgstr "ຢຸດການຕິດຕາມໃບຢັ້ງຢືນ\n"

#: src/getcert.c:5180
msgid "resubmit an in-progress enrollment request, or start a new one\n"
msgstr "ສົ່ງຄຳຮ້ອງຂໍລົງທະບຽນທີ່ກຳລັງດຳເນີນການຢູ່ອີກຄັ້ງ ຫຼື ເລີ່ມຄຳຮ້ອງຂໍໃໝ່\n"

#: src/getcert.c:5182
msgid "generate a new private key and replace a certificate\n"
msgstr "ສ້າງຄີສ່ວນຕົວໃໝ່ ແລະ ປ່ຽນແທນໃບຢັ້ງຢືນ\n"

#: src/getcert.c:5184
msgid "check on the status of an in-progress enrollment request\n"
msgstr "ກວດສອບສະຖານະຂອງຄຳຮ້ອງຂໍລົງທະບຽນທີ່ກຳລັງດຳເນີນການຢູ່\n"

#: src/getcert.c:5186
msgid "list certificates being monitored and requested\n"
msgstr "ສະແດງລາຍການໃບຢັ້ງຢືນທີ່ກຳລັງຖືກຕິດຕາມ ແລະ ຖືກຮ້ອງຂໍຢູ່\n"

#: src/getcert.c:5188
msgid "check the status of a certificate being monitored or requested\n"
msgstr "ກວດສອບສະຖານະຂອງໃບຢັ້ງຢືນທີ່ກຳລັງຖືກຕິດຕາມ ຫຼື ຖືກຮ້ອງຂໍຢູ່\n"

#: src/getcert.c:5191
msgid "add a CA configuration\n"
msgstr "ເພີ່ມການຕັ້ງຄ່າ CA\n"

#: src/getcert.c:5193
msgid "add an SCEP CA configuration\n"
msgstr "ເພີ່ມການຕັ້ງຄ່າ SCEP CA\n"

#: src/getcert.c:5196
msgid "list known CA configurations\n"
msgstr "ສະແດງລາຍການການຕັ້ງຄ່າ CA ທີ່ຮູ້ຈັກ\n"

#: src/getcert.c:5199
msgid "modify a CA configuration\n"
msgstr "ແກ້ໄຂການຕັ້ງຄ່າ CA\n"

#: src/getcert.c:5202
msgid "refresh cache of all information obtained from a CA\n"
msgstr "ຣີເຟຣຊແຄຊ (cache) ຂອງຂໍ້ມູນທັງໝົດທີ່ໄດ້ຮັບຈາກ CA\n"

#: src/getcert.c:5205
msgid "remove a CA configuration\n"
msgstr "ລຶບການຕັ້ງຄ່າ CA ອອກ\n"

#: src/getcert.c:5273
#, c-format
msgid "%s: unrecognized command\n"
msgstr "%s: ບໍ່ຮູ້ຈັກຄຳສັ່ງ\n"

#: src/ipa.c:144
#, c-format
msgid "Unable to determine location of IPA LDAP server.\n"
msgstr "ບໍ່ສາມາດລະບຸທີ່ຕັ້ງຂອງເຊີເວີ IPA LDAP ໄດ້.\n"

#: src/ipa.c:149
#, c-format
msgid "Unable to contact an IPA LDAP server.\n"
msgstr "ບໍ່ສາມາດຕິດຕໍ່ເຊີເວີ IPA LDAP ໄດ້.\n"

#: src/ipa.c:233 src/ipa.c:533
#, c-format
msgid "Unable to determine base DN of domain information on IPA server.\n"
msgstr "ບໍ່ສາມາດລະບຸ base DN ຂອງຂໍ້ມູນໂດເມນໃນເຊີເວີ IPA ໄດ້.\n"

#: src/ipa.c:369
#, c-format
msgid "Error setting up for XMLRPC on the client.\n"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການຕັ້ງຄ່າ XMLRPC ຢູ່ຝັ່ງໄຄລເອັນ.\n"

#: src/ipa.c:658
#, c-format
msgid "The -t option can not be used with the -K option.\n"
msgstr "ບໍ່ສາມາດໃຊ້ຕົວເລືອກ -t ຮ່ວມກັບຕົວເລືອກ -K ໄດ້.\n"

#: src/ipa.c:667
#, c-format
msgid "The -k option can not be used with the -K option.\n"
msgstr "ບໍ່ສາມາດໃຊ້ຕົວເລືອກ -k ຮ່ວມກັບຕົວເລືອກ -K ໄດ້.\n"

#: src/ipa.c:676
#, c-format
msgid "The -K option can not be used with either the -k or the -t option.\n"
msgstr "ບໍ່ສາມາດໃຊ້ຕົວເລືອກ -K ຮ່ວມກັບຕົວເລືອກ -k ຫຼື -t ໄດ້.\n"

#: src/ipa.c:758
#, c-format
msgid "Unable to determine principal name for signing request.\n"
msgstr "ບໍ່ສາມາດລະບຸຊື່ principal ສຳລັບຄຳຮ້ອງຂໍລົງລາຍເຊັນໄດ້.\n"

#: src/ipa.c:831
#, c-format
msgid "No IPA domain configured, and none specified.\n"
msgstr "ບໍ່ໄດ້ຕັ້ງຄ່າໂດເມນ IPA ແລະ ບໍ່ມີການລະບຸໄວ້.\n"

#: src/ipa.c:868
#, c-format
msgid ""
"Error setting up ccache for \"host\" service on client using default keytab: "
"%s.\n"
msgstr ""
"ເກີດຂໍ້ຜິດພາດໃນການຕັ້ງຄ່າ ccache ສຳລັບບໍລິການ \"host\" ຢູ່ຝັ່ງໄຄລເອັນໂດຍໃຊ້ keytab ເລີ່ມຕົ້ນ: "
"%s.\n"

#: src/ipa.c:872
#, c-format
msgid ""
"Error setting up ccache for \"%s\" on client using default keytab: %s.\n"
msgstr ""
"ເກີດຂໍ້ຜິດພາດໃນການຕັ້ງຄ່າ ccache ສຳລັບ \"%s\" ຢູ່ຝັ່ງໄຄລເອັນໂດຍໃຊ້ keytab ເລີ່ມຕົ້ນ: %s.\n"

#: src/ipa.c:879
#, c-format
msgid ""
"Error setting up ccache for \"host\" service on client using keytab \"%s\": "
"%s.\n"
msgstr ""
"ເກີດຂໍ້ຜິດພາດໃນການຕັ້ງຄ່າ ccache ສຳລັບບໍລິການ \"host\" ຢູ່ຝັ່ງໄຄລເອັນໂດຍໃຊ້ keytab \"%s\": "
"%s.\n"

#: src/ipa.c:883
#, c-format
msgid "Error setting up ccache for \"%s\" on client using keytab \"%s\": %s.\n"
msgstr ""
"ເກີດຂໍ້ຜິດພາດໃນການຕັ້ງຄ່າ ccache ສຳລັບ \"%s\" ຢູ່ຝັ່ງໄຄລເອັນໂດຍໃຊ້ keytab \"%s\": %s.\n"

#: src/local.c:556
#, c-format
msgid "Unable to read signing request.\n"
msgstr "ບໍ່ສາມາດອ່ານຄຳຮ້ອງຂໍລົງລາຍເຊັນໄດ້.\n"

#: src/main.c:74
msgid "use session bus"
msgstr "ໃຊ້ session bus"

#: src/main.c:75
msgid "use system bus"
msgstr "ໃຊ້ system bus"

#: src/main.c:76
msgid "start a dedicated listening socket"
msgstr "ເລີ່ມຕົ້ນ listening socket ແບບສະເພາະ"

#: src/main.c:77
msgid "only use a dedicated listening socket"
msgstr "ໃຊ້ສະເພາະ listening socket ແບບສະເພາະເທົ່ານັ້ນ"

#: src/main.c:78
msgid "specify the dedicated listening socket"
msgstr "ລະບຸ listening socket ແບບສະເພາະ"

#: src/main.c:78
msgid "PATHNAME"
msgstr "ຊື່ເສັ້ນທາງ"

#: src/main.c:79
msgid "don't become a daemon"
msgstr "ບໍ່ຕ້ອງເຮັດວຽກເປັນເດມອນ"

#: src/main.c:80
msgid "do become a daemon"
msgstr "ໃຫ້ເຮັດວຽກເປັນເດມອນ"

#: src/main.c:81
msgid "bus-activated, idle timeout"
msgstr "ເປີດໃຊ້ງານໂດຍ bus, ກຳນົດເວລາໝົດອາຍຸເມື່ອບໍ່ມີການເຄື່ອນໄຫວ"

#: src/main.c:81
msgid "SECONDS"
msgstr "ວິນາທີ"

#: src/main.c:82
msgid "don't use an idle timeout"
msgstr "ບໍ່ຕ້ອງໃຊ້ການກຳນົດເວລາໝົດອາຍຸເມື່ອບໍ່ມີການເຄື່ອນໄຫວ"

#: src/main.c:83
msgid "set debugging level (implies -n)"
msgstr "ກຳນົດລະດັບການດີບັກ (debugging) (ໝາຍເຖິງການໃຊ້ -n ໄປໃນຕົວ)"

#: src/main.c:83
msgid "NUMBER"
msgstr "ຕົວເລກ"

#: src/main.c:84 src/main.c:86
msgid "start COMMAND and exit when it does"
msgstr "ເລີ່ມຕົ້ນ ຄຳສັ່ງ ແລະ ອອກຈາກໂປຣແກຣມເມື່ອຄຳສັ່ງນັ້ນສິ້ນສຸດ"

#: src/main.c:87
msgid "write service PID to file"
msgstr "ຂຽນ PID ຂອງບໍລິການລົງໃນໄຟລ໌"

#: src/main.c:88
msgid "force NSS into FIPS mode"
msgstr "ບັງຄັບໃຫ້ NSS ເຂົ້າສູ່ໂໝດ FIPS"

#: src/main.c:90
msgid "print version information"
msgstr "ສະແດງຂໍ້ມູນເວີຊັນ"

#: src/main.c:174
#, c-format
msgid "Usage: %s [-s|-S] [-n|-f] [-d LEVEL] [-p FILE] [-F] [-v]\n"
msgstr "ວິທີໃຊ້: %s [-s|-S] [-n|-f] [-d LEVEL] [-p FILE] [-F] [-v]\n"

#: src/main.c:177
msgid "\t-s         use session bus\n"
msgstr "\t-s         ໃຊ້ session bus\n"

#: src/main.c:178
msgid "\t-S         use system bus\n"
msgstr "\t-S         ໃຊ້ system bus\n"

#: src/main.c:179
msgid "\t-l         start a dedicated listening socket\n"
msgstr "\t-l         ເລີ່ມຕົ້ນ listening socket ແບບສະເພາະ\n"

#: src/main.c:180
msgid "\t-L         only use a dedicated listening socket\n"
msgstr "\t-L         ໃຊ້ສະເພາະ listening socket ແບບສະເພາະເທົ່ານັ້ນ\n"

#: src/main.c:181
msgid "\t-P PATH    specify the dedicated listening socket\n"
msgstr "\t-P PATH    ລະບຸ listening socket ແບບສະເພາະ\n"

#: src/main.c:182
msgid "\t-n         don't become a daemon\n"
msgstr "\t-n         ບໍ່ຕ້ອງເຮັດວຽກເປັນເດມອນ\n"

#: src/main.c:183
msgid "\t-f         do become a daemon\n"
msgstr "\t-f         ໃຫ້ເຮັດວຽກເປັນເດມອນ\n"

#: src/main.c:184
msgid "\t-b TIMEOUT bus-activated, idle timeout\n"
msgstr ""
"\t-b TIMEOUT ເປີດໃຊ້ງານໂດຍ bus, ກຳນົດເວລາໝົດອາຍຸເມື່ອບໍ່ມີການເຄື່ອນໄຫວ\n"

#: src/main.c:185
msgid "\t-B         don't use an idle timeout\n"
msgstr "\t-B         ບໍ່ຕ້ອງໃຊ້ການກຳນົດເວລາໝົດອາຍຸເມື່ອບໍ່ມີການເຄື່ອນໄຫວ\n"

#: src/main.c:186
msgid "\t-d LEVEL   set debugging level (implies -n)\n"
msgstr "\t-d LEVEL   ກຳນົດລະດັບການດີບັກ (ໝາຍເຖິງການໃຊ້ -n ໄປໃນຕົວ)\n"

#: src/main.c:187
msgid "\t-c COMMAND start COMMAND and exit when it does\n"
msgstr "\t-c COMMAND ເລີ່ມຕົ້ນ ຄຳສັ່ງ ແລະ ອອກຈາກໂປຣແກຣມເມື່ອຄຳສັ່ງນັ້ນສິ້ນສຸດ\n"

#: src/main.c:188
msgid "\t-p FILE    write service PID to file\n"
msgstr "\t-p FILE    ຂຽນ PID ຂອງບໍລິການລົງໃນໄຟລ໌\n"

#: src/main.c:189
msgid "\t-F         force NSS into FIPS mode\n"
msgstr "\t-F         ບັງຄັບໃຫ້ NSS ເຂົ້າສູ່ໂໝດ FIPS\n"

#: src/main.c:190
msgid "\t-v         print version information and exit\n"
msgstr "\t-v         ສະແດງຂໍ້ມູນເວີຊັນແລ້ວອອກຈາກໂປຣແກຣມ\n"

#: src/scep.c:352
#, c-format
msgid "No SCEP URL (-u) given, and no default known.\n"
msgstr "ບໍ່ໄດ້ລະບຸ URL ຂອງ SCEP (-u) ແລະ ບໍ່ມີຄ່າເລີ່ມຕົ້ນ.\n"

#: src/scep.c:356
#, c-format
msgid "No SCEP operation (-c/-C/-g/-p) given, and no default known.\n"
msgstr "ບໍ່ໄດ້ລະບຸການເຮັດວຽກຂອງ SCEP (-c/-C/-g/-p) ແລະ ບໍ່ມີຄ່າເລີ່ມຕົ້ນ.\n"

#: src/scep.c:376 src/scep.c:395
#, c-format
msgid "No RA certificate (-r) given, and no default known.\n"
msgstr "ບໍ່ໄດ້ລະບຸໃບຢັ້ງຢືນ RA (-r) ແລະ ບໍ່ມີຄ່າເລີ່ມຕົ້ນ.\n"

#: src/scep.c:386 src/scep.c:540
#, c-format
msgid ""
"Error reading request.  Expected PKCS7 data containing a GetInitialCert "
"pkiMessage, got nothing.\n"
msgstr ""
"ເກີດຂໍ້ຜິດພາດໃນການອ່ານຄຳຮ້ອງຂໍ. ຕ້ອງການຂໍ້ມູນ PKCS7 ທີ່ມີ GetInitialCert pkiMessage ແຕ່ບໍ່ພົບຂໍ້ມູ"
"ນໃດໆ.\n"

#: src/scep.c:405 src/scep.c:565
#, c-format
msgid ""
"Error reading request.  Expected PKCS7 data containing a PKCSReq pkiMessage, "
"got nothing.\n"
msgstr ""
"ເກີດຂໍ້ຜິດພາດໃນການອ່ານຄຳຮ້ອງຂໍ. ຕ້ອງການຂໍ້ມູນ PKCS7 ທີ່ມີ PKCSReq pkiMessage ແຕ່ບໍ່ພົບຂໍ້ມູນໃດໆ.\n"

#: src/scep.c:433 src/scep.c:459
#, c-format
msgid "Warning: request is neither a PKCSReq nor a GetInitialCert request.\n"
msgstr "ຄຳເຕືອນ: ຄຳຮ້ອງຂໍບໍ່ແມ່ນທັງ PKCSReq ຫຼື GetInitialCert.\n"

#: src/scep.c:437 src/scep.c:463
#, c-format
msgid ""
"Warning: request type \"%s\"is neither a PKCSReq nor a GetInitialCert "
"request.\n"
msgstr "ຄຳເຕືອນ: ປະເພດຄຳຮ້ອງຂໍ \"%s\" ບໍ່ແມ່ນທັງ PKCSReq ຫຼື GetInitialCert.\n"

#: src/scep.c:470
#, c-format
msgid "Warning: request is missing transactionId.\n"
msgstr "ຄຳເຕືອນ: ຄຳຮ້ອງຂໍຂາດ transactionId.\n"

#: src/scep.c:474
#, c-format
msgid "Warning: request is missing senderNonce.\n"
msgstr "ຄຳເຕືອນ: ຄຳຮ້ອງຂໍຂາດ senderNonce.\n"

#: src/scep.c:637
#, c-format
msgid "Got response code %d from %s, not 200.\n"
msgstr "ໄດ້ຮັບລະຫັດການຕອບກັບ %d ຈາກ %s, ເຊິ່ງບໍ່ແມ່ນ 200.\n"

#: src/scep.c:685 src/scep.c:1121
#, c-format
msgid "Server reply was of unexpected MIME type \"%s\".\n"
msgstr "ການຕອບກັບຈາກເຊີເວີມີປະເພດ MIME \"%s\" ທີ່ບໍ່ຄາດຄິດ.\n"

#: src/scep.c:930
#, c-format
msgid "Error: failed to verify signature on server response.\n"
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ສາມາດກວດສອບລາຍເຊັນໃນການຕອບກັບຈາກເຊີເວີ.\n"

#: src/scep.c:946
#, c-format
msgid "Error: reply was not a CertRep (%s).\n"
msgstr "ຂໍ້ຜິດພາດ: ການຕອບກັບບໍ່ແມ່ນ CertRep (%s).\n"

#: src/scep.c:951
#, c-format
msgid "Error: reply is missing transactionId.\n"
msgstr "ຂໍ້ຜິດພາດ: ການຕອບກັບຂາດ transactionId.\n"

#: src/scep.c:956
#, c-format
msgid "Error: reply contains a different transactionId.\n"
msgstr "ຂໍ້ຜິດພາດ: ການຕອບກັບມີ transactionId ທີ່ແຕກຕ່າງກັນ.\n"

#: src/scep.c:962
#, c-format
msgid "Error: reply is missing pkiStatus.\n"
msgstr "ຂໍ້ຜິດພາດ: ການຕອບກັບຂາດ pkiStatus.\n"

#: src/scep.c:966
#, c-format
msgid "Error: reply is missing recipientNonce.\n"
msgstr "ຂໍ້ຜິດພາດ: ການຕອບກັບຂາດ recipientNonce.\n"

#: src/scep.c:972
#, c-format
msgid "Error: reply nonce doesn't match request.\n"
msgstr "ຂໍ້ຜິດພາດ: ຄ່າ nonce ໃນການຕອບກັບບໍ່ກົງກັບຄຳຮ້ອງຂໍ.\n"

#: src/scep.c:976
#, c-format
msgid "Error: reply is missing senderNonce.\n"
msgstr "ຂໍ້ຜິດພາດ: ການຕອບກັບຂາດ senderNonce.\n"

#: src/scep.c:994
#, c-format
msgid "Unspecified failure at server.\n"
msgstr "ເກີດຄວາມລົ້ມເຫຼວທີ່ບໍ່ໄດ້ລະບຸຢູ່ຝັ່ງເຊີເວີ.\n"

#: src/scep.c:997
#, c-format
msgid "Unrecognized or unsupported algorithm identifier in client request.\n"
msgstr "ພົບຕົວລະບຸອັນກໍຣິທຶມທີ່ບໍ່ຮູ້ຈັກ ຫຼື ບໍ່ຮອງຮັບໃນຄຳຮ້ອງຂໍຂອງໄຄລເອັນ.\n"

#: src/scep.c:1000
#, c-format
msgid "Integrity check of client request failed at server.\n"
msgstr ""
"ການກວດສອບຄວາມຖືກຕ້ອງ (integrity) ຂອງຄຳຮ້ອງຂໍໄຄລເອັນລົ້ມເຫຼວຢູ່ຝັ່ງເຊີເວີ.\n"

#: src/scep.c:1003
#, c-format
msgid "Transaction either is not permitted or is not supported by server.\n"
msgstr "ທຸລະກຳບໍ່ໄດ້ຮັບອະນຸຍາດ ຫຼື ບໍ່ຮອງຮັບໂດຍເຊີເວີ.\n"

#: src/scep.c:1006
#, c-format
msgid "Clock skew too great.\n"
msgstr "ເວລາຂອງໂມງແຕກຕ່າງກັນຫຼາຍເກີນໄປ.\n"

#: src/scep.c:1009
#, c-format
msgid "Unsupported extension.\n"
msgstr "ສ່ວນຂະຫຍາຍທີ່ບໍ່ຮອງຮັບ.\n"

#: src/scep.c:1012
#, c-format
msgid "Must archive keys.\n"
msgstr "ຕ້ອງເຮັດການເກັບຮັກສາຄີ (archive keys).\n"

#: src/scep.c:1015
#, c-format
msgid "Bad identity.\n"
msgstr "ຕົວຕົນ (identity) ບໍ່ຖືກຕ້ອງ.\n"

#: src/scep.c:1018
#, c-format
msgid "Proof of possession required.\n"
msgstr "ຕ້ອງການຫຼັກຖານການຄອບຄອງ.\n"

#: src/scep.c:1021
#, c-format
msgid "Proof of possession failed.\n"
msgstr "ການກວດສອບຫຼັກຖານການຄອບຄອງລົ້ມເຫຼວ.\n"

#: src/scep.c:1024
#, c-format
msgid "No key reuse.\n"
msgstr "ບໍ່ໃຫ້ໃຊ້ຄີຊ້ຳ.\n"

#: src/scep.c:1027
#, c-format
msgid "Internal CA error.\n"
msgstr "ຂໍ້ຜິດພາດພາຍໃນຂອງ CA.\n"

#: src/scep.c:1030
#, c-format
msgid "Try later.\n"
msgstr "ກະລຸນາລອງໃໝ່ໃນພາຍຫຼັງ.\n"

#: src/scep.c:1032
#, c-format
msgid "Server returned failure code \"%s\".\n"
msgstr "ເຊີເວີສົ່ງຄືນລະຫັດຄວາມລົ້ມເຫຼວ \"%s\".\n"

#: src/scep.c:1044
#, c-format
msgid "Error: couldn't parse signed-data.\n"
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ສາມາດວິເຄາະ signed-data ໄດ້.\n"

#: src/scep.c:1059 src/scep.c:1074
#, c-format
msgid "Error: signed-data payload is not enveloped-data.\n"
msgstr "ຂໍ້ຜິດພາດ: ເພໂຫຼດ (payload) ຂອງ signed-data ບໍ່ແມ່ນ enveloped-data.\n"

#: src/scep.c:1092
#, c-format
msgid "Error: enveloped-data payload is not data.\n"
msgstr "ຂໍ້ຜິດພາດ: ເພໂຫຼດຂອງ enveloped-data ບໍ່ແມ່ນຂໍ້ມູນ (data).\n"

#: src/scep.c:1116
#, c-format
msgid "Error: pkiStatus \"%s\" not recognized.\n"
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ຮູ້ຈັກ pkiStatus \"%s\".\n"

#: src/tdbush.c:119 src/tdbush.c:1944 src/tdbush.c:2351
msgid "An internal error has occurred."
msgstr "ເກີດຂໍ້ຜິດພາດພາຍໃນຂຶ້ນ."

#: src/tdbush.c:183
msgid "No matching entry found.\n"
msgstr "ບໍ່ພົບລາຍການທີ່ກົງກັນ.\n"

#: src/tdbush.c:345
#, c-format
msgid "There is already a CA with the nickname \"%s\"."
msgstr "ມີ CA ທີ່ໃຊ້ຊື່ອ້າງອີງ \"%s\" ຢູ່ແລ້ວ."

#: src/tdbush.c:439
msgid "Certificate storage type not specified."
msgstr "ບໍ່ໄດ້ລະບຸປະເພດບ່ອນເກັບໃບຢັ້ງຢືນ."

#: src/tdbush.c:452
#, c-format
msgid "Certificate storage type \"%s\" not supported."
msgstr "ບໍ່ຮອງຮັບປະເພດບ່ອນເກັບໃບຢັ້ງຢືນ \"%s\"."

#: src/tdbush.c:489 src/tdbush.c:522 src/tdbush.c:581 src/tdbush.c:766
#: src/tdbush.c:825 src/tdbush.c:928 src/tdbush.c:973 src/tdbush.c:1028
#: src/tdbush.c:1073 src/tdbush.c:1128 src/tdbush.c:1173 src/tdbush.c:1592
#: src/tdbush.c:3230 src/tdbush.c:3382
#, c-format
msgid "The location \"%s\" must be an absolute path."
msgstr "ທີ່ຕັ້ງ \"%s\" ຕ້ອງເປັນເສັ້ນທາງເຕັມ (absolute path)."

#: src/tdbush.c:516 src/tdbush.c:575 src/tdbush.c:644
msgid "Certificate storage location not specified."
msgstr "ບໍ່ໄດ້ລະບຸທີ່ຕັ້ງບ່ອນເກັບໃບຢັ້ງຢືນ."

#: src/tdbush.c:534 src/tdbush.c:778 src/tdbush.c:985 src/tdbush.c:1085
#: src/tdbush.c:1185
#, c-format
msgid ""
"The parent of location \"%s\" could not be accessed due to insufficient "
"permissions."
msgstr ""
"ບໍ່ສາມາດເຂົ້າເຖິງໂຟນເດີແມ່ຂອງ \"%s\" ໄດ້ ເນື່ອງຈາກສິດການເຂົ້າເຖິງບໍ່ພຽງພໍ."

#: src/tdbush.c:542 src/tdbush.c:786 src/tdbush.c:993 src/tdbush.c:1093
#: src/tdbush.c:1193
#, c-format
msgid "The parent of location \"%s\" must be a valid directory."
msgstr "ໂຟນເດີແມ່ຂອງ \"%s\" ຕ້ອງເປັນໄດເຣັກທໍຣີທີ່ຖືກຕ້ອງ."

#: src/tdbush.c:553 src/tdbush.c:797 src/tdbush.c:1004 src/tdbush.c:1104
#: src/tdbush.c:1204
#, c-format
msgid "The location \"%s\" must be a file."
msgstr "ທີ່ຕັ້ງ \"%s\" ຕ້ອງເປັນໄຟລ໌."

#: src/tdbush.c:593 src/tdbush.c:940 src/tdbush.c:1040 src/tdbush.c:1140
#, c-format
msgid ""
"The location \"%s\" could not be accessed due to insufficient permissions."
msgstr "ບໍ່ສາມາດເຂົ້າເຖິງທີ່ຕັ້ງ \"%s\" ໄດ້ ເນື່ອງຈາກສິດການເຂົ້າເຖິງບໍ່ພຽງພໍ."

#: src/tdbush.c:601 src/tdbush.c:834 src/tdbush.c:948 src/tdbush.c:1048
#: src/tdbush.c:1148
#, c-format
msgid "The location \"%s\" must be a directory."
msgstr "ທີ່ຕັ້ງ \"%s\" ຕ້ອງເປັນໄດເຣັກທໍຣີ."

#: src/tdbush.c:622
msgid "Certificate nickname not specified."
msgstr "ບໍ່ໄດ້ລະບຸຊື່ອ້າງອີງໃບຢັ້ງຢືນ."

#: src/tdbush.c:665 src/tdbush.c:3055
#, c-format
msgid "There is already a request with the nickname \"%s\"."
msgstr "ມີຄຳຮ້ອງຂໍທີ່ໃຊ້ຊື່ອ້າງອີງ \"%s\" ຢູ່ແລ້ວ."

#: src/tdbush.c:701
#, c-format
msgid ""
"Certificate at same location is already used by request with nickname \"%s\"."
msgstr ""
"ໃບຢັ້ງຢືນຢູ່ທີ່ຕັ້ງດຽວກັນຖືກໃຊ້ໂດຍຄຳຮ້ອງຂໍທີ່ມີຊື່ອ້າງອີງ \"%s\" ຢູ່ແລ້ວ."

#: src/tdbush.c:734
#, c-format
msgid "Key storage type \"%s\" not supported."
msgstr "ບໍ່ຮອງຮັບປະເພດບ່ອນເກັບຄີ \"%s\"."

#: src/tdbush.c:760 src/tdbush.c:819
msgid "Key storage location not specified."
msgstr "ບໍ່ໄດ້ລະບຸທີ່ຕັ້ງບ່ອນເກັບຄີ."

#: src/tdbush.c:853
msgid "Key nickname not specified."
msgstr "ບໍ່ໄດ້ລະບຸຊື່ອ້າງອີງຄີ."

#: src/tdbush.c:909
#, c-format
msgid "Key at same location is already used by request with nickname \"%s\"."
msgstr "ຄີຢູ່ທີ່ຕັ້ງດຽວກັນຖືກໃຊ້ໂດຍຄຳຮ້ອງຂໍທີ່ມີຊື່ອ້າງອີງ \"%s\" ຢູ່ແລ້ວ."

#: src/tdbush.c:1313 src/tdbush.c:3102
#, c-format
msgid "No support for key type \"%s\"."
msgstr "ບໍ່ຮອງຮັບປະເພດຄີ \"%s\"."

#: src/tdbush.c:1400
msgid "No such CA."
msgstr "ບໍ່ມີ CA ດັ່ງກ່າວ."

#: src/tdbush.c:3073
#, c-format
msgid "Certificate authority \"%s\" not known."
msgstr "ບໍ່ຮູ້ຈັກຜູ້ອອກໃບຢັ້ງຢືນຊີເອ \"%s\"."

#: src/tdbush.c:3518
msgid "Unrecognized parameter or wrong value type."
msgstr "ພາຣາມິເຕີທີ່ບໍ່ຮູ້ຈັກ ຫຼື ປະເພດຄ່າບໍ່ຖືກຕ້ອງ."

#: src/tdbush.c:5070
msgid "Error parsing arguments."
msgstr "ເກີດຂໍ້ຜິດພາດໃນການວິເຄາະອາກິວເມນ."

#: src/tdbush.c:5124
msgid "Unrecognized property name."
msgstr "ບໍ່ຮູ້ຈັກຊື່ຄຸນສົມບັດ (property name)."

#: src/tdbusm.c:2156
msgid "Insufficient access.  Please retry operation as root.\n"
msgstr "ສິດການເຂົ້າເຖິງບໍ່ພຽງພໍ. ກະລຸນາລອງໃໝ່ໃນຖານະ root.\n"

#: src/tdbusm.c:2160
msgid "Please verify that the certmonger service has been started.\n"
msgstr "ກະລຸນາກວດສອບວ່າບໍລິການ certmonger ໄດ້ຖືກເລີ່ມຕົ້ນແລ້ວ.\n"

#: src/tdbusm.c:2163
msgid "Please verify that the certmonger service is still running.\n"
msgstr "ກະລຸນາກວດສອບວ່າບໍລິການ certmonger ຍັງຄົງເຮັດວຽກຢູ່.\n"
