#: src/getcert.c:4871
msgid "  -E EMAIL\toverride requested email address\n"
msgstr "  -E EMAIL\tຂຽນທັບທີ່ຢູ່ອີເມລທີ່ຮ້ອງຂໍ\n"

#: src/getcert.c:4872
msgid "  -A ADDRESS\toverride requested IP address\n"
msgstr "  -A ADDRESS\tຂຽນທັບທີ່ຢູ່ IP ທີ່ຮ້ອງຂໍ\n"

#: src/getcert.c:4888
#, c-format
msgid "Usage: %s stop-tracking [options]\n"
