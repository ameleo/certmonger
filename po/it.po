#: src/getcert.c:1114
#, c-format
msgid ""
"The IPA backend requires the use of the -K option (principal name) when any "
"of the -N (subject name), -E (email address), -A (IP address), -D (DNS "
"name), or -U (extendedKeyUsage) options is used.\n"
msgstr ""
"Il backend IPA richiede l'uso dell'opzione -K (nome principale) quando viene "
"utilizzata una qualsiasi delle opzioni -N (nome soggetto), -E (indirizzo "
"e-mail), -A (indirizzo IP), -D (nome DNS) o -U (extendedKeyUsage).\n"

