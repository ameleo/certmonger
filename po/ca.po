#: src/main.c:174
#, c-format
msgid "Usage: %s [-s|-S] [-n|-f] [-d LEVEL] [-p FILE] [-F] [-v]\n"
msgstr "Ús: %s [-s|-S] [-n|-f] [-d NIVELL] [-p FITXER] [-F] [-v]\n"

#: src/main.c:177
msgid "\t-s         use session bus\n"
msgstr "\t-s         utilitza el bus de la sessió\n"

#: src/main.c:178
msgid "\t-S         use system bus\n"
msgstr "\t-S         utilitza el bus del sistema\n"

#: src/main.c:179
msgid "\t-l         start a dedicated listening socket\n"
msgstr "\t-l         inicia un socket dedicat a escoltar\n"

#: src/main.c:180
msgid "\t-L         only use a dedicated listening socket\n"
msgstr "\t-L         tan sols utilitza el socket dedicat a escoltar\n"

